4:["$","p",null,{"className":"max-w-2xl text-[17px] leading-relaxed text-foreground","children":"Every kidney-diet app runs on the USDA food database, which is close to useless for dal, roti and sabzi. None of them warn about salt substitutes — marketed as the healthy choice, and dangerous for this group because they are potassium chloride. VitaLoop exists for those two gaps."}]
5:["$","section",null,{"className":"pb-20 md:pb-28","children":["$","div",null,{"className":"mx-auto max-w-5xl px-6 md:px-10 lg:px-16","children":[["$","h2",null,{"className":"mb-6 text-[11px] font-semibold uppercase tracking-[0.16em] text-muted-foreground","children":"What it does"}],["$","dl",null,{"className":"divide-y divide-border border-y border-border","children":[["$","div","Renal-aware food logging",{"className":"grid gap-1.5 py-5 md:grid-cols-[16rem_1fr] md:gap-10","children":[["$","dt",null,{"className":"text-[15px] font-semibold tracking-tight text-foreground","children":"Renal-aware food logging"}],["$","dd",null,{"className":"max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":"Search an Indian food database or scan a barcode. Each food is scored for your stage on sodium, potassium and phosphorus."}]]}],["$","div","Salt-substitute warnings",{"className":"grid gap-1.5 py-5 md:grid-cols-[16rem_1fr] md:gap-10","children":[["$","dt",null,{"className":"text-[15px] font-semibold tracking-tight text-foreground","children":"Salt-substitute warnings"}],["$","dd",null,{"className":"max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":"Low-sodium salt is potassium chloride. For a kidney that cannot clear potassium, that is a cardiac risk — so the app says so."}]]}],["$","div","Hidden phosphorus additives",{"className":"grid gap-1.5 py-5 md:grid-cols-[16rem_1fr] md:gap-10","children":[["$","dt",null,{"className":"text-[15px] font-semibold tracking-tight text-foreground","children":"Hidden phosphorus additives"}],["$","dd",null,{"className":"max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":"Additive phosphorus absorbs far more readily than natural phosphorus and is often not itemised on labels. Flagged where we can detect it."}]]}],["$","div","Fluid tracking",{"className":"grid gap-1.5 py-5 md:grid-cols-[16rem_1fr] md:gap-10","children":[["$","dt",null,{"className":"text-[15px] font-semibold tracking-tig